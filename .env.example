# Scribe Configuration (med-scribe-alliance-ts-sdk — open MedScribe Alliance protocol)
#
# Env vars are baked in at plugin build time — rebuild after changing this file.

# Spoken language hint for transcription, comma-separated ISO codes.
# Forcing the language greatly improves accuracy for non-English clinics —
# auto-detection runs per audio chunk and flip-flops on code-switched speech.
# e.g. "ta" for Tamil. Leave unset for auto-detect.
# REACT_SCRIBE_LANGUAGES=ta

# Scribe backend resolution (automatic — usually nothing to configure):
#   1. REACT_SCRIBE_BE_URL, if set — explicit override (standalone server)
#   2. window.CARE_API_URL + /api/care_scribe_be — CARE backend plugin,
#      authenticated with the logged-in CARE user's token
# REACT_SCRIBE_BE_URL=
